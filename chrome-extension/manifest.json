{
  "manifest_version": 3,
  "name": "SCUA for Chrome",
  "description": "Keeps SCUA automation inside an owned Chrome tab group.",
  "version": "0.1.0",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ]
}
