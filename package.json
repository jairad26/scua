{
	"name": "@jairad26/scua",
	"version": "0.5.0",
	"description": "State-scoped semantic computer use with isolated roots, shared leases, and independent agent cursors.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"computer-use",
		"macos",
		"desktop-automation",
		"accessibility",
		"linux"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jairad26/scua.git"
	},
	"bugs": {
		"url": "https://github.com/jairad26/scua/issues"
	},
	"homepage": "https://github.com/jairad26/scua#readme",
	"engines": {
		"node": ">=20.6.0"
	},
	"files": [
		".codex-plugin",
		".mcp.json",
		"extensions",
		"mcp",
		"src",
		"scripts/run-mcp.sh",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/macos/bridge.swift",
		"native/windows/bridge-rs/Cargo.lock",
		"native/windows/bridge-rs/Cargo.toml",
		"native/windows/bridge-rs/src",
		"native/windows/bridge-rs/tests",
		"prebuilt/macos",
		"prebuilt/windows",
		"benchmarks/README.md",
		"benchmarks/adapters",
		"benchmarks/lib",
		"benchmarks/native",
		"benchmarks/pilot",
		"benchmarks/run-pilot.mjs",
		"benchmarks/scua-agent.mjs",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE",
		"native/linux/bridge-rs",
		"prebuilt/linux",
		"docs"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "./assets/reference/img.jpg"
	},
	"scripts": {
		"postinstall": "node scripts/setup-helper.mjs --postinstall",
		"mcp": "node mcp/server.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "node scripts/check-tool-schemas.mjs",
		"test:invariants": "node scripts/check-invariants.mjs",
		"test:config": "node scripts/check-config.mjs",
		"test:lifecycle": "tsx scripts/check-session-lifecycle.mjs",
		"test:runtime": "tsx scripts/check-runtime-concurrency.mjs",
		"test:helper-transport": "tsx scripts/check-helper-transport.mjs",
		"test:control-plane": "tsx scripts/check-control-plane.mjs",
		"soak:control-plane": "node scripts/soak-control-plane.mjs --duration-minutes 60",
		"test:action-plan": "tsx scripts/check-action-plan.mjs",
		"test:user-activity": "tsx scripts/check-user-activity.mjs",
		"test:cdp": "tsx scripts/check-cdp-runtime.mjs",
		"test:multi-agent-live": "SCUA_MULTI_AGENT_LIVE=1 node scripts/check-multi-agent-live.mjs",
		"test:semantic-index-live": "SCUA_SEMANTIC_INDEX_LIVE=1 SCUA_AX_NODE_LIMIT=100 node scripts/check-semantic-index-live.mjs",
		"test:logical-actors-live": "SCUA_LOGICAL_ACTORS_LIVE=1 node scripts/check-logical-actors-live.mjs",
		"test:finder-rename-live": "SCUA_FINDER_RENAME_LIVE=1 node scripts/check-finder-rename-live.mjs",
		"test:doc-ock-live": "SCUA_DOC_OCK_LIVE=1 node scripts/check-doc-ock-live.mjs",
		"test:doc-ock-showcase-live": "SCUA_DOC_OCK_SHOWCASE_LIVE=1 node scripts/check-doc-ock-showcase-live.mjs",
		"test:output": "tsx scripts/check-bounded-output.mjs",
		"test:commits": "node scripts/check-commit-messages.mjs",
		"test:platform": "tsx scripts/check-platform-windows.mjs",
		"test:windows-scripts": "node scripts/check-windows-build-scripts.mjs",
		"test:signing": "node scripts/check-local-signing.mjs",
		"test:macos-path": "node scripts/check-macos-helper-path.mjs",
		"test:benchmark": "node scripts/check-benchmark-harness.mjs",
		"benchmark:pilot": "node benchmarks/run-pilot.mjs",
		"test": "npm run typecheck && npm run test:config && npm run test:schema && npm run test:mcp && npm run test:mcp-compact && npm run test:package-files && npm run test:output && npm run test:lifecycle && npm run test:runtime && npm run test:helper-transport && npm run test:control-plane && npm run test:action-plan && npm run test:user-activity && npm run test:cdp && npm run test:benchmark && npm run test:invariants && npm run test:platform && npm run test:linux && npm run test:linux-scripts && npm run test:signing && npm run test:macos-path",
		"test:mcp": "node scripts/check-mcp-server.mjs",
		"test:mcp-compact": "node scripts/check-mcp-compact.mjs",
		"test:package-files": "node scripts/check-package-files.mjs",
		"build:native": "node scripts/build-native.mjs",
		"install:macos-source-helper": "node scripts/setup-helper.mjs --source-build",
		"build:windows": "node scripts/build-native.mjs --platform windows",
		"build:linux": "node scripts/build-native.mjs --platform linux",
		"test:linux": "tsx scripts/check-platform-linux.mjs",
		"test:linux-scripts": "node scripts/check-linux-build-scripts.mjs",
		"test:linux-live": "PI_CU_LIVE=1 tsx scripts/check-linux-live.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
